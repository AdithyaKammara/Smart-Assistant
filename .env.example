# Copy to .env.local and fill in. Never commit .env.local.

# Vercel AI Gateway key (https://vercel.com/ai-gateway). Not needed when deployed
# on Vercel with OIDC.
AI_GATEWAY_API_KEY=

# Any "provider/model" string the gateway supports.
CHAT_MODEL=anthropic/claude-sonnet-5.5

# Supabase (phase 2: auth + saved conversations). Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
