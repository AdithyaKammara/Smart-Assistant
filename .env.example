# Copy to .env.local and fill in. Never commit .env.local.
# Set ONE provider key. The app uses the first one it finds, in this order.

# 1. Google Gemini: free tier, no credit card. https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# 2. Groq: free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# 3. Vercel AI Gateway: needs a card on file. https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: force a provider (google | groq | gateway) or a model id.
# CHAT_PROVIDER=
# CHAT_MODEL=

# Supabase (phase 2: auth + saved conversations). Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
