# Copy to .env.local and fill in. Never commit .env.local.

# --- Model: set ONE key. The app uses the first one it finds, in this order. ---
# 1. Google Gemini: free tier, no card. Also used for PDF embeddings. https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# 2. Groq: free tier, no card. https://console.groq.com/keys
GROQ_API_KEY=
# 3. Vercel AI Gateway: needs a card on file. https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# Optional: force a provider (google | groq | gateway) or a model id.
# CHAT_PROVIDER=
# CHAT_MODEL=

# --- Supabase: auth, saved chats, documents. Project Settings -> API. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional ---
# Messages per user per hour (default 60).
# MESSAGES_PER_HOUR=60
# Langfuse tracing; leave empty to turn it off. https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# A test account for the signed-in Playwright test.
# E2E_EMAIL=
# E2E_PASSWORD=
